BIND_ADDRESS=0.0.0.0
PORT=7373
# Empty: use the IP/host and port from the browser request automatically.
PUBLIC_BASE_URL=
FPS=15

# Optional: replace the address lookup provider with your own Photon instance.
GEOCODER_URL=https://photon.komoot.io/api/

# Recommended production setup with an existing trusted certificate:
# python3 deploy/configure_https.py YOUR-IP-OR-HOST CERTIFICATE-NAME
# That command enables compose.https.yaml and sets these values in .env:
# COMPOSE_FILE=compose.yaml:compose.https.yaml
# PUBLIC_HOST=YOUR-IP-OR-HOST
# TLS_CERT_NAME=CERTIFICATE-NAME
# TLS_CERT_DIR=/etc/letsencrypt
# The management URL becomes HTTPS; Xtream remains HTTP on PORT.
